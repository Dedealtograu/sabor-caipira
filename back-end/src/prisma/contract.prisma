// use prisma-8

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  password  String
  mission   String   @default("garçom")
  admin     Boolean @default(false)
  login     String   @default("bloqueado")
}

model Product {
  id        String   @id @default(uuid())
  name      String
  description String
  category  String
  image     String   @default("")
  price     Decimal
}
