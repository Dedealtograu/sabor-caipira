// use prisma-8
// Contract inferred from the live database schema. Edit as needed, then run `prisma contract emit`.

model User {
  id        String @id @default(uuid())
  email     String @unique
  name      String
  password  String
  mission   String @default("garçom")
  admin     Boolean @default(false)
  login     String @default("bloqueado") // desbloqueado ou bloqueado
}
