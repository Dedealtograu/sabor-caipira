generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  password  String
  mission   String   @default("garçom")
  admin     Boolean @default(false)
  login     String   @default("bloqueado")

  orderItems OrderItem[]
}

model Product {
  id        String   @id @default(uuid())
  name      String
  description String
  category  String
  image     String   @default("")
  price     Decimal

  orderItems OrderItem[]
}

model OrderItem {
  id String @id @default(uuid())
  productId String
  product Product  @relation(fields: [productId], references: [id])
  userId String
  user User @relation(fields: [userId], references: [id])
}
